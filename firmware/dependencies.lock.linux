dependencies:
  idf:
    source:
      type: idf
    version: 5.5.6
  lcd349:
    component_hash: 59f3bd4dd784a5928c9afeab5ae6b381971d3c4c188ed2198588c1a1e1e67d91
    dependencies:
    - name: idf
      version: '>=5.5,<5.6'
    - name: lvgl/lvgl
      require: public
      version: 9.6.0
    - name: espressif/esp_lcd_axs15231b
      rules:
      - if: target == esp32s3
      version: 2.1.1
    - name: espressif/esp_codec_dev
      rules:
      - if: target == esp32s3
      version: 1.6.2
    source:
      git: https://github.com/MaverickHQ/lcd349-kit.git
      path: components/lcd349
      type: git
    targets:
    - esp32s3
    - linux
    version: cdc1d8936dd9a565cacefa8c9fa0e432850e5941
  lvgl/lvgl:
    component_hash: d5e723db3a3feca71e34e333a6598b7624e3822577d374e1d44f0e18374952e1
    dependencies:
    - name: espressif/freetype
      registry_url: https://components.espressif.com
      require: private
      rules:
      - if: idf_version >=5.5 && $CONFIG{LV_USE_FREETYPE} == True
      version: ^2.14.3
    - name: espressif/libjpeg-turbo
      registry_url: https://components.espressif.com
      require: private
      rules:
      - if: idf_version >=5.5 && $CONFIG{LV_USE_LIBJPEG_TURBO} == True
      version: ^3.1.1
    - name: espressif/libpng
      registry_url: https://components.espressif.com
      require: private
      rules:
      - if: idf_version >=5.5 && $CONFIG{LV_USE_LIBPNG} == True
      version: ^1.6.58
    - name: espressif/lz4
      registry_url: https://components.espressif.com
      require: private
      rules:
      - if: idf_version >=5.5 && $CONFIG{LV_USE_LZ4} == True && $CONFIG{LV_USE_LZ4_INTERNAL} == False
      version: ^1.10.0
    source:
      registry_url: https://components.espressif.com/
      type: service
    version: 9.6.0
direct_dependencies:
- idf
- lcd349
manifest_hash: 40536bc35c536907f4c508bae35929509b80260ba9ff1191153ecbe92b361859
target: linux
version: 2.0.0
